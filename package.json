{
  "name": "thehumorproject",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:gallery-ui": "node --import tsx --test scripts/gallery-ui.test.mjs",
    "test:images-db": "node --test scripts/images-db.test.mjs",
    "test:images-media": "node --conditions=react-server --import tsx --test scripts/images-media.test.mjs",
    "test:dashboard-ui": "node --import tsx --test scripts/dashboard-ui.test.mjs",
    "test:dashboard-api": "node --conditions=react-server --import tsx --test scripts/dashboard-api.test.mjs",
    "test:leaderboard-ui": "node --import tsx --test scripts/leaderboard-ui.test.mjs",
    "test:leaderboard-db": "node --test scripts/leaderboard-db.test.mjs",
    "test:leaderboard-api": "node --conditions=react-server --import tsx --test scripts/leaderboard-api.test.mjs",
    "leaderboard:admin": "node --env-file=.env.local scripts/leaderboard-admin.mjs",
    "test:roast": "node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/roast.test.mjs scripts/roast-ui.test.mjs && node --conditions=react-server --import tsx --test scripts/roast-provider.test.mjs",
    "test:factory": "node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/disguise-ui.test.mjs && node --conditions=react-server --import tsx --test scripts/factory-server.test.mjs scripts/factory-render.test.mjs && node --test scripts/factory-db.test.mjs",
    "test:disguise": "node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/disguise-ui.test.mjs && node --conditions=react-server --import tsx --test scripts/seedream-generation.test.mjs",
    "test:images-reference": "node --import tsx --test scripts/seedream-reference.test.mjs",
    "test:roast-publication": "node --conditions=react-server --import tsx --test scripts/roast-publication.test.mjs",
    "test:ego-db": "node --test scripts/ego-db.test.mjs",
    "test:ego-ui": "node --import tsx --test scripts/ego-ui.test.mjs",
    "test:ego-receipts": "node --conditions=react-server --import tsx --test scripts/ego-receipts.test.mjs",
    "test:checkboard": "node --conditions=react-server --import tsx --test scripts/checkboard-data.test.mjs scripts/works-server.test.mjs && node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/works-ui.test.mjs",
    "test:daily-quest": "node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/daily-quest-ui.test.mjs scripts/checkly-dashboard.test.mjs",
    "test:guest-ui": "node --import tsx --import ./scripts/roast-css-loader.mjs --test scripts/guest-landing-ui.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "next": "16.3.5",
    "opentype.js": "^2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
